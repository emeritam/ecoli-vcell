    given-names: "Emerita"
    orcid: "https://orcid.org/0000-0001-5676-1472"
    affiliation: "Brookhaven National Laboratory, Upton, NY, USA"
repository-code: "https://github.com/emeritam/ecoli-vcell"
url: "https://emeritam.github.io/ecoli-vcell/"
license: MIT
